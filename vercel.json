{
  "version": 2,
  "buildCommand": "npx vite build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/assessment", "destination": "/api/index.ts" },
    { "source": "/api/health", "destination": "/api/index.ts" },
    { "source": "/api/leads", "destination": "/api/index.ts" },
    { "source": "/api/assessment/:id/pdf", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
